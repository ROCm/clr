+def install():
+    from sglang.srt.layers.attention.dsa.dsa_indexer import Indexer
+    from sglang.srt.layers.attention.dsa.dsa_indexer_metadata import DSAIndexerMetadata
+    from sglang.srt.model_executor.forward_context import get_token_to_kv_pool
+    from sglang.srt.model_executor.runner.decode_cuda_graph_runner import (
+        DecodeCudaGraphRunner,
+    )
+
+    original_forward = Indexer.forward_cuda
+
+    def forward(self, x, q_lora, positions, forward_batch, layer_id, *args, **kwargs):
+        global _active, _canonical_reference
+        owner = self.projection_schedule
+        if owner is None or not forward_batch.forward_mode.is_target_verify():
+            return original_forward(
+                self, x, q_lora, positions, forward_batch, layer_id, *args, **kwargs
+            )
+        pool = get_token_to_kv_pool()
+        cache = pool.get_index_k_with_scale_buffer(layer_id=layer_id)
+        before = cache.clone()
+        candidate_stages = {}
+        reference_stages = {}
+        saved_mode = owner.mode
+        try:
+            _active = candidate_stages
+            _tap("input_x", x)
+            _tap("input_q_lora", q_lora)
+            candidate = original_forward(
+                self, x, q_lora, positions, forward_batch, layer_id, *args, **kwargs
+            )
+            if (
+                os.environ.get("NATIVE_FAULT_MISSING_JOIN") == "1"
+                and saved_mode == "events"
+            ):
+                # Close the captured side branch after the deliberately early
+                # consumers, so the negative-control graph itself remains valid.
+                torch.cuda.current_stream().wait_event(owner.events[layer_id][1])
+            candidate_cache = cache.clone()
+            candidate_saved = candidate.clone() if candidate is not None else None
+            cache.copy_(before)
+            owner.mode = "serial"
+            _active = reference_stages
+            if _coherent_shadow:
+                _canonical_reference = {
+                    "wq_b": candidate_stages["wq_b/0"][0],
+                    "wk": candidate_stages["wk/0"][0],
+                }
+            _tap("input_x", x)
+            _tap("input_q_lora", q_lora)
+            reference = original_forward(
+                self, x, q_lora, positions, forward_batch, layer_id, *args, **kwargs
+            )
+        finally:
+            _canonical_reference = None
+            _active = None
+            owner.mode = saved_mode
+        if candidate_stages.keys() != reference_stages.keys():
+            raise AssertionError("Candidate/reference stage census differs")
+        for name, values in candidate_stages.items():
+            if name == "selector_validity":
+                _compare(
+                    f"L{layer_id}/candidate_selector_valid",
+                    values[0],
+                    torch.ones_like(values[0]),
+                )
+                _compare(
+                    f"L{layer_id}/reference_selector_valid",
+                    reference_stages[name][0],
+                    torch.ones_like(reference_stages[name][0]),
+                )
+            if len(values) != len(reference_stages[name]):
+                raise AssertionError(f"Stage invocation mismatch: {name}")
+            for i, (actual, expected) in enumerate(zip(values, reference_stages[name])):
+                _compare(f"L{layer_id}/{name}/{i}", actual, expected)
+                if _characterize:
+                    _stage_taps[f"L{layer_id}/{name}/{i}"] = (actual, expected)
+            if name in ("wq_b/0", "wk/0"):
+                _projection_taps[f"L{layer_id}/{name}"] = values[0]
+            if name.startswith(("wq_b", "wk", "input_", "topk_", "indexer_logits")):
+                actual_debug, expected_debug = values[0], reference_stages[name][0]
+                if name.startswith(("indexer_logits", "topk_page_table")):
+                    actual_debug, expected_debug = (
+                        actual_debug[..., :8192],
+                        expected_debug[..., :8192],
+                    )
+                _debug_taps[f"L{layer_id}/candidate/{name}"] = actual_debug
+                _debug_taps[f"L{layer_id}/reference/{name}"] = expected_debug
+        _compare(
+            f"L{layer_id}/complete_cache_written_and_untouched", candidate_cache, cache
+        )
+        if _coherent_shadow:
+            from sglang.srt.layers.attention.dsa.utils import (
+                INDEXER_K_CACHE_PRESHUFFLE_TILE,
+                aiter_can_use_preshuffle_paged_mqa,
+            )
+
+            loc = forward_batch.out_cache_loc.long().reshape(-1, 1)
+            page = loc // pool.page_size
+            token = loc % pool.page_size
+            columns = torch.arange(pool.index_head_dim, device=loc.device).reshape(
+                1, -1
+            )
+            base = page * cache.shape[1]
+            if aiter_can_use_preshuffle_paged_mqa():
+                tile = INDEXER_K_CACHE_PRESHUFFLE_TILE
+                key_offsets = (
+                    base
+                    + (token // tile) * (tile * pool.index_head_dim)
+                    + (columns // tile) * (tile * tile)
+                    + (token % tile) * tile
+                    + columns % tile
+                )
+            else:
+                key_offsets = base + token * pool.index_head_dim + columns
+            scale_offsets = (
+                base
+                + pool.page_size * pool.index_head_dim
+                + token * 4
+                + torch.arange(4, device=loc.device).reshape(1, -1)
+            )
+            written = torch.cat((key_offsets, scale_offsets), dim=1).flatten()
+            untouched = candidate_cache.clone().flatten()
+            untouched[written] = before.flatten()[written]
+            _compare(f"L{layer_id}/untouched_cache_exact", untouched, before.flatten())
+        if _characterize:
+            pages = forward_batch.out_cache_loc // pool.page_size
+            _stage_taps[f"L{layer_id}/cache_written_pages"] = (
+                candidate_cache[pages].clone(),
+                cache[pages].clone(),
+            )
+        if candidate_saved is not None:
+            if _coherent_shadow:
+                _compare(
+                    f"L{layer_id}/candidate_selector_output_binding",
+                    candidate_saved,
+                    candidate_stages["topk_transform"][0],
+                )
+                _compare(
+                    f"L{layer_id}/reference_selector_output_binding",
+                    reference,
+                    reference_stages["topk_transform"][0],
+                )
+            _compare(f"L{layer_id}/selected_indices", candidate_saved, reference)
+        # Consumers must see the selected execution, including when a diagnostic
+        # failure is present. The serial shadow may reuse metadata output buffers.
+        cache.copy_(candidate_cache)
+        return candidate_saved
+
+    Indexer.forward_cuda = forward
+    if os.environ.get("NATIVE_FAULT_MISSING_JOIN") == "1":
+        from sglang.srt.model_executor.runner_utils.indexer_projection_schedule import (
+            IndexerProjectionSchedule,
+        )
+
+        original_key = IndexerProjectionSchedule.key
+
+        def missing_join(self, layer_id, projection, x):
+            if self.mode != "events":
+                return original_key(self, layer_id, projection, x)
+            ready, done = self.events[layer_id]
+            with torch.cuda.stream(self.stream):
+                self.stream.wait_event(ready)
+                torch.cuda._sleep(20_000_000)
+                key, _ = projection(x)
+                done.record(self.stream)
+            return key
+
+        IndexerProjectionSchedule.key = missing_join
+    for method in ("_get_q_k_bf16", "_get_logits_head_gate"):
+        original = getattr(Indexer, method)
+
+        def wrapped(self, *args, _original=original, _label=method, **kwargs):
+            return _tap(_label, _original(self, *args, **kwargs))
+
+        setattr(Indexer, method, wrapped)
+    original_topk = DSAIndexerMetadata.topk_transform
+
+    def topk(self, logits, *args, **kwargs):
+        _tap("topk_page_table", self.attn_metadata.page_table_1[..., :8192])
+        _tap("topk_lengths", self.get_seqlens_expanded())
+        _tap("indexer_logits", logits)
+        selected = original_topk(self, logits, *args, **kwargs)
+        if _coherent_shadow and _active is not None:
+            from sglang.srt.environ import envs
+            from sglang.srt.layers.attention.dsa.dsa_topk_backend import (
+                TopkTransformMethod,
+            )
+
+            if (
+                self.topk_transform_method != TopkTransformMethod.PAGED
+                or not envs.SGLANG_DSA_FUSE_TOPK.get()
+                or envs.SGLANG_DSA_TOPK_BROADCAST.get()
+            ):
+                raise AssertionError(
+                    "Unsupported selector mapping for exact validity oracle"
+                )
+            _tap(
+                "selector_validity",
+                selector_validity(
+                    logits,
+                    selected,
+                    self.attn_metadata.page_table_1,
+                    self.get_seqlens_expanded(),
+                ),
+            )
+        return _tap("topk_transform", selected)
+
+    DSAIndexerMetadata.topk_transform = topk
+    from sglang.kernels.ops.attention.dsa import tilelang_kernel
+
+    original_quant = tilelang_kernel.act_quant
+
+    def quant(*args, **kwargs):
+        return _tap("query_quant_bytes_scales", original_quant(*args, **kwargs))
+
+    tilelang_kernel.act_quant = quant
+    execute_baseline = DecodeCudaGraphRunner.execute
+
+    def original_execute(self, forward_batch, *args, **kwargs):
+        global _last_replay
+        if (
+            not self.model_runner.is_draft_worker
+            and self.backend._projection_schedule is not None
+        ):
+            _serving_checks_enabled.fill_(True)
+        output = execute_baseline(self, forward_batch, *args, **kwargs)
+        if (
+            not self.model_runner.is_draft_worker
+            and self.backend._projection_schedule is not None
+        ):
+            _last_replay = (self._replay_graph_key, forward_batch)
+            _compare(
+                "final_logits_finite_every_replay",
+                torch.isfinite(output.next_token_logits).all().reshape(1),
+                torch.ones(1, dtype=torch.bool, device="cuda"),
+            )
+        return output
+
+    def execute(self, forward_batch, *args, **kwargs):
+        output = original_execute(self, forward_batch, *args, **kwargs)
+        if (
+            self.model_runner.is_draft_worker
+            or self.backend._projection_schedule is None
+        ):
+            return output
+        key = str(self._replay_graph_key)
+        taps = _graph_taps[self._replay_graph_key]
+        if not taps:
+            raise AssertionError("No actual main-attention/layer output taps")
+        count = _runner_counts.get(key, 0)
+        if _characterize:
+            if (
+                os.environ["GPU_NATIVE_EVENT_WAIT"] != "0"
+                or self.backend._projection_schedule.mode != "serial"
+            ):
+                raise AssertionError("Characterization is restricted to A")
+            if count == 0:
+                characterize_runner(self, forward_batch, original_execute, args, kwargs)
+            _runner_counts[key] = count + 1
+            _check(f"characterization_serving/{key}/{count}")
+            return output
