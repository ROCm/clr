@@ -0,0 +1,903 @@
+"""Diagnostic hooks for the actual L10 serving runner; never a timing harness.
+
+Install in every worker before ModelRunner construction. Each target Indexer runs
+the selected schedule and the original serial path against restored cache bytes.
+The selected output continues through the unchanged main attention/model. Error
+flags accumulate on device, including across queued real-runner executions.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import sys
+from pathlib import Path
+
+import torch
+
+_active = None
+_errors = None
+_slots = {}
+_full_taps = {}
+_graph_taps = {}
+_projection_taps = {}
+_graph_projection_taps = {}
+_debug_taps = {}
+_graph_debug_taps = {}
+_runner_counts = {}
+_stage_taps = {}
+_graph_stage_taps = {}
+_characterize = os.environ.get("NATIVE_BASELINE_CHARACTERIZE") == "1"
+_canonical_reference = None
+_observed = None
+_observed_slots = {}
+_last_replay = None
+_serving_checks_enabled = None
+_coherent_shadow = os.environ.get("NATIVE_COHERENT_SHADOW") == "1"
+_envelope = None
+if _coherent_shadow:
+    envelope_path = Path(os.environ["NATIVE_QK_ENVELOPE"])
+    envelope_bytes = envelope_path.read_bytes()
+    if (
+        hashlib.sha256(envelope_bytes).hexdigest()
+        != "2271908e86c1afbf0a1a194e6ba7721c3acdc742d578f65188ccab05ab7da772"
+    ):
+        raise AssertionError("Frozen A-derived Q/K envelope changed")
+    _envelope = json.loads(envelope_bytes)["projections"]
+
+
+def _tensors(value, prefix=""):
+    if isinstance(value, torch.Tensor):
+        yield prefix, value
+    elif isinstance(value, (tuple, list)):
+        for i, child in enumerate(value):
+            yield from _tensors(child, f"{prefix}/{i}")
+    elif isinstance(value, dict):
+        for name, child in value.items():
+            yield from _tensors(child, f"{prefix}/{name}")
+
+
+def _tap(label, value):
+    if _active is not None:
+        for suffix, tensor in _tensors(value):
+            name = f"{label}{suffix}"
+            _active.setdefault(name, []).append(tensor.clone())
+    return value
+
+
+def _compare(name, actual, expected):
+    if actual.shape != expected.shape or actual.dtype != expected.dtype:
+        raise AssertionError(f"Diagnostic shape/dtype mismatch: {name}")
+    if _coherent_shadow and name.startswith(
+        ("final_logits/", "consumer/", "alternating/")
+    ):
+        slot = _observed_slots.setdefault(name, len(_observed_slots))
+        mismatch = torch.any(
+            actual.contiguous().view(torch.uint8)
+            != expected.contiguous().view(torch.uint8)
+        )
+        _observed[slot].logical_or_(mismatch)
+        return
+    slot = _slots.setdefault(name, len(_slots))
+    if slot >= _errors.numel():
+        raise AssertionError("Diagnostic error bank exhausted")
+    ordered_selection = _coherent_shadow and (
+        "/topk_transform/" in name or name.endswith("/selected_indices")
+    )
+    if ordered_selection:
+        _errors[slot].logical_or_(
+            torch.any((actual < 0) != (expected < 0))
+            | torch.any(actual < -1)
+            | torch.any(expected < -1)
+        )
+        slot_observed = _observed_slots.setdefault(
+            "ordered_selection/" + name, len(_observed_slots)
+        )
+        _observed[slot_observed].logical_or_(torch.any(actual != expected))
+        return
+    projection = next(
+        (
+            projection
+            for projection in ("wq_b", "wk")
+            if name.endswith(f"/{projection}/0/0")
+        ),
+        None,
+    )
+    if _coherent_shadow and projection is not None:
+        bound = _envelope[projection]
+        a, b = actual.float(), expected.float()
+        difference = (a - b).abs()
+        reference_rms = b.square().mean().sqrt()
+        mismatch = (
+            ~torch.isfinite(a).all()
+            | ~torch.isfinite(b).all()
+            | (
+                difference.square().mean().sqrt()
+                > bound["max_normalized_rms"] * reference_rms
+            )
+            | (difference.max() > bound["max_abs_over_reference_rms"] * reference_rms)
+        )
+    else:
+        mismatch = torch.any(
+            actual.contiguous().view(torch.uint8)
+            != expected.contiguous().view(torch.uint8)
+        )
+    _errors[slot].logical_or_(mismatch)
+
+
+def _check(where):
+    torch.cuda.synchronize()
+    flags = _errors.cpu().tolist()
+    failed = [name for name, slot in _slots.items() if flags[slot]]
+    observed_flags = _observed.cpu().tolist() if _observed is not None else []
+    receipt = {
+        "where": where,
+        "comparisons": list(_slots),
+        "failed": failed,
+        "cross_replay_numerical_differences": [
+            name for name, slot in _observed_slots.items() if observed_flags[slot]
+        ],
+        "qualification": "projection_and_event_dependencies_only"
+        if _coherent_shadow
+        else "original_exact_or_characterization",
+    }
+    if _observed is not None:
+        _observed.zero_()
+    path = Path(os.environ["NATIVE_ARM_OUTPUT"])
+    rank = torch.distributed.get_rank()
+    with (path / f"correctness-rank{rank}.jsonl").open("a") as file:
+        file.write(json.dumps(receipt) + "\n")
+    if _characterize:
+        _errors.zero_()
+    if failed and not _characterize:
+        if _last_replay is not None:
+            graph_key, batch = _last_replay
+            failure_path = path / f"first-failure-rank{rank}.pt"
+            if not failure_path.exists():
+                values = {
+                    name: tensor.cpu()
+                    for name, tensor in _graph_debug_taps[graph_key].items()
+                }
+                values.update(
+                    input_ids=batch.input_ids.cpu(),
+                    positions=batch.positions.cpu(),
+                    out_cache_loc=batch.out_cache_loc.cpu(),
+                    seq_lens=batch.seq_lens.cpu(),
+                    failed=failed,
+                    where=where,
+                )
+                torch.save(values, failure_path)
+        raise AssertionError(f"Projection/consumer mismatch at {where}: {failed}")
+
+
+def attach(model_runner, indexers):
+    """Called by the private worker launcher before the real runner captures."""
+    global _errors, _observed, _serving_checks_enabled
+    if getattr(model_runner, "_native_diagnostic_attached", False):
+        return
+    model_runner._native_diagnostic_attached = True
+    if _errors is None:
+        _errors = torch.zeros(512, dtype=torch.bool, device="cuda")
+        _observed = torch.zeros(512, dtype=torch.bool, device="cuda")
+        _serving_checks_enabled = torch.zeros(1, dtype=torch.bool, device="cuda")
+    for indexer in indexers:
+        if not hasattr(indexer, "wq_b") and not hasattr(indexer, "wk"):
+            continue
+        for name in ("wq_b", "wk", "k_norm", "rotary_emb"):
+
+            def stage_hook(module, args, output, label=name):
+                _tap(label, output)
+                if _canonical_reference is not None and label in _canonical_reference:
+                    # The original complete projection above still ran and was
+                    # retained. Feed equal raw inputs to downstream consumers.
+                    return (_canonical_reference[label].clone(), *output[1:])
+                return output
+
+            getattr(indexer, name).register_forward_hook(stage_hook)
+    for name, module in model_runner.model.named_modules():
+        if type(module).__name__ == "DeepseekV2DecoderLayer" or (
+            name.endswith("self_attn") and hasattr(module, "layer_id")
+        ):
+
+            def save(module, args, output, label=name):
+                for suffix, tensor in _tensors(output):
+                    _full_taps[f"{label}{suffix}"] = tensor.clone()
+
+            module.register_forward_hook(save)
+
+
+def begin_capture():
+    _full_taps.clear()
+    _projection_taps.clear()
+    _debug_taps.clear()
+    _stage_taps.clear()
+
+
+def finish_capture(key):
+    _graph_taps[key] = dict(_full_taps)
+    _graph_projection_taps[key] = dict(_projection_taps)
+    _graph_debug_taps[key] = dict(_debug_taps)
+    _graph_stage_taps[key] = dict(_stage_taps)
