+def check_lifecycle(runner):
+    """Exercise the actual backend failure path, then real-runner recapture."""
+    backend = runner.backend
+    owner = backend._projection_schedule
+    old_graphs = dict(backend._graphs)
+    old_events = dict(owner.graph_events)
+    key = next(iter(old_graphs))
+
+    class InjectedFailure(Exception):
+        pass
+
+    def fail():
+        raise InjectedFailure("intentional pre-capture forward failure")
+
+    try:
+        with backend.capture_session(runner.stream):
+            backend.capture_one(key, fail)
+    except InjectedFailure:
+        pass
+    else:
+        raise AssertionError("Capture failure injection did not execute")
+    if backend._graphs != old_graphs or owner.graph_events != old_events:
+        raise AssertionError("Failed capture retired a live graph/event generation")
+    if owner.events is not owner.eager_events:
+        raise AssertionError("Failed capture left temporary event ownership active")
+    runner.capture()
+    if any(backend._graphs[k] is graph for k, graph in old_graphs.items()):
+        raise AssertionError("Real runner did not replace all graphs on recapture")
+    if any(owner.graph_events[k][0] <= pair[0] for k, pair in old_events.items()):
+        raise AssertionError("Real runner did not advance event generations")
+    indexers = list(backend._projection_indexers)
+    backend.cleanup()
+    if backend._graphs or owner.graph_events or owner.events:
+        raise AssertionError("Backend cleanup retained a graph/event generation")
+    if any(indexer.projection_schedule is not None for indexer in indexers):
+        raise AssertionError("Backend cleanup did not detach the owner")
+    from sglang.srt.model_executor.runner_backend.utils import resolve_decode_backend
+
+    runner.backend = resolve_decode_backend(runner)
+    runner.capture()
+    _check("capture_failure_and_recapture")
+
+
+def discrepancy(actual, expected):
+    a = actual.detach().cpu().contiguous()
+    b = expected.detach().cpu().contiguous()
+    av, bv = a.flatten(), b.flatten()
+    mask = (
+        av.view(torch.uint8).reshape(av.numel(), -1)
+        != bv.view(torch.uint8).reshape(bv.numel(), -1)
+    ).any(1)
+    finite = torch.isfinite(av.float()) & torch.isfinite(bv.float())
+    delta = torch.where(finite, (av.float() - bv.float()).abs(), 0)
+    maximum = int(delta.argmax())
+    first = mask.nonzero().flatten()[:16]
+    row = dict(
+        shape=list(a.shape),
+        dtype=str(a.dtype),
+        different=int(mask.sum()),
+        count=a.numel(),
+        max_abs=float(delta.max()),
+        rms=float(delta.square().mean().sqrt()),
+        reference_rms=float(bv.float()[finite].square().mean().sqrt())
+        if finite.any()
+        else 0.0,
+        nonfinite_pattern_equal=bool(
+            torch.equal(torch.isfinite(av.float()), torch.isfinite(bv.float()))
+        ),
+        max_index=maximum,
+        max_values=[float(av[maximum]), float(bv[maximum])],
+        first_indices=first.tolist(),
+        first_actual=av.float()[first].tolist(),
+        first_expected=bv.float()[first].tolist(),
+    )
+    if a.dtype in (torch.int32, torch.int64) and a.ndim == 2:
+        row["ordered_equal"] = bool(torch.equal(a, b))
+        row["selected_sets_equal"] = all(
+            set(x.tolist()) == set(y.tolist()) for x, y in zip(a, b)
+        )
+        row["minimum_set_overlap"] = min(
+            len(set(x.tolist()) & set(y.tolist()))
+            / max(1, len(set(x.tolist()) | set(y.tolist())))
+            for x, y in zip(a, b)
+        )
+    return row
+
+
+def characterize_runner(runner, forward_batch, original_execute, args, kwargs):
+    key = runner._replay_graph_key
+    taps = _graph_taps[key]
+    stages = _graph_stage_taps[key]
+    output_dir = Path(os.environ["NATIVE_ARM_OUTPUT"])
+    rank = torch.distributed.get_rank()
+    pool = runner.model_runner.token_to_kv_pool
+    # Restore the complete target main-attention and index cache state before
+    # each same-input replay; graph metadata is prepared by actual execute().
+    mutable = list(pool.kv_buffer) + list(pool.index_key_cache.buffer)
+    snapshots = [tensor.clone() for tensor in mutable]
+    torch.cuda.synchronize()
+    baseline = None
+    records = []
+    saved_raw = {}
+    for trial in range(32):
+        for tensor, saved in zip(mutable, snapshots):
+            tensor.copy_(saved)
+        result = original_execute(runner, forward_batch, *args, **kwargs)
+        torch.cuda.synchronize()
+        current = {f"consumer/{name}": tensor.clone() for name, tensor in taps.items()}
+        current["final_logits"] = result.next_token_logits.clone()
+        if baseline is None:
+            baseline = {name: tensor.clone() for name, tensor in current.items()}
+        rows = {
+            f"within_forward/{name}": discrepancy(a, b)
+            for name, (a, b) in stages.items()
+        }
+        rows.update(
+            {
+                f"same_input_replay/{name}": discrepancy(tensor, baseline[name])
+                for name, tensor in current.items()
+            }
+        )
+        records.append(dict(trial=trial, comparisons=rows))
+        if trial in (0, 31):
+            saved_raw[str(trial)] = {
+                f"within_forward/{name}/{side}": tensor.cpu()
+                for name, pair in stages.items()
+                for side, tensor in zip(("candidate", "serial_reference"), pair)
+            }
+            saved_raw[str(trial)].update(
+                {name: tensor.cpu() for name, tensor in current.items()}
+            )
+        _check(f"characterization/{key}/same_input{trial}")
+    for tensor, saved in zip(mutable, snapshots):
+        tensor.copy_(saved)
+    original_execute(runner, forward_batch, *args, **kwargs)
+    name = f"characterization-rank{rank}-graph{len(_runner_counts)}"
+    torch.save(saved_raw, output_dir / (name + ".pt"))
+    receipt = dict(
+        valid_as_correctness=False,
+        key=str(key),
+        input_ids=forward_batch.input_ids.cpu().tolist(),
+        positions=forward_batch.positions.cpu().tolist(),
+        out_cache_loc=forward_batch.out_cache_loc.cpu().tolist(),
+        restored_cache_bytes=sum(
+            tensor.numel() * tensor.element_size() for tensor in mutable
+        ),
+        records=records,
+    )
+    (output_dir / (name + ".json")).write_text(json.dumps(receipt, indent=2))
+
