+def selector_validity(logits, selected, table, lengths):
+    # Fixed diagnostic domain covers all <=6144-token correctness fixtures.
+    # Full primary serving never installs this helper.
+    columns = min(8192, logits.shape[-1], table.shape[-1])
+    score = logits[:, :columns]
+    lengths = lengths.reshape(-1, 1)
+    if lengths.shape[0] == 1:
+        lengths = lengths.expand(score.shape[0], 1)
+    if table.shape[0] == 1:
+        table = table.expand(score.shape[0], -1)
+    positions = torch.arange(columns, device=score.device).reshape(1, -1)
+    eligible = positions < lengths
+    physical = torch.where(
+        eligible, table[:, :columns].long(), torch.iinfo(torch.int64).max
+    )
+    sorted_physical, logical_order = physical.sort(dim=1)
+    found = torch.searchsorted(
+        sorted_physical.contiguous(), selected.long().contiguous()
+    ).clamp(max=columns - 1)
+    mapped_physical = sorted_physical.gather(1, found)
+    logical = logical_order.gather(1, found)
+    selected_valid = selected >= 0
+    mapped = ((mapped_physical == selected) | ~selected_valid).all(dim=1)
+    selected_scores = score.gather(1, logical)
+    masked_scores = torch.where(eligible, score, -torch.inf)
+    k = selected.shape[1]
+    threshold = masked_scores.topk(k, dim=1).values[:, -1:]
+    expected_count = lengths.clamp(max=k).flatten()
+    correct_count = selected_valid.sum(dim=1) == expected_count
+    sorted_selected = selected.sort(dim=1).values
+    unique = ~(
+        (sorted_selected[:, 1:] == sorted_selected[:, :-1])
+        & (sorted_selected[:, 1:] >= 0)
+    ).any(dim=1)
+    none_below = ((selected_scores >= threshold) | ~selected_valid).all(dim=1)
+    all_above = ((selected_scores > threshold) & selected_valid).sum(dim=1) == (
+        masked_scores > threshold
+    ).sum(dim=1)
+    domain = ((lengths >= 0) & (lengths <= columns)).flatten()
+    finite = (torch.isfinite(score) | ~eligible).all(dim=1)
+    valid_sentinels = (selected >= -1).all(dim=1)
+    mapping_injective = ~(
+        (sorted_physical[:, 1:] == sorted_physical[:, :-1])
+        & (sorted_physical[:, 1:] != torch.iinfo(torch.int64).max)
+    ).any(dim=1)
+    valid = (
+        mapped
+        & correct_count
+        & unique
+        & none_below
+        & all_above
+        & domain
+        & finite
+        & valid_sentinels
+        & mapping_injective
+    )
+    # Capture uses artificial zero page tables. The persistent flag is set
+    # before every actual runner execution, and is false only during startup.
+    return valid | ~_serving_checks_enabled
+
