+"""CPU checks for ordinary-event ordering and graph-generation ownership."""
+
+import contextlib
+import importlib.util
+import sys
+from pathlib import Path
+from types import SimpleNamespace
+from unittest import TestCase, mock
+
+import torch
+
+# Import the actual helper without importing device backends or the public API.
+SOURCE = (
+    Path(__file__).resolve().parents[5]
+    / "python/sglang/srt/model_executor/runner_utils/indexer_projection_schedule.py"
+)
+spec = importlib.util.spec_from_file_location("indexer_projection_schedule", SOURCE)
+module = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(module)
+
+ci_path = SOURCE.parents[3] / "test/ci/ci_register.py"
+ci_spec = importlib.util.spec_from_file_location("ci_register", ci_path)
+ci_module = importlib.util.module_from_spec(ci_spec)
+sys.modules[ci_spec.name] = ci_module
+ci_spec.loader.exec_module(ci_module)
+register_cpu_ci = ci_module.register_cpu_ci
+register_cpu_ci(est_time=2, suite="base-a-test-cpu")
+
+
+class TestProjectionSchedule(TestCase):
+    def setUp(self):
+        self.log = []
+        self.main = SimpleNamespace(
+            wait_event=lambda event: self.log.append(("main_wait", event))
+        )
+        self.side = SimpleNamespace(
+            wait_event=lambda event: self.log.append(("side_wait", event))
+        )
+
+        def event(**kwargs):
+            result = SimpleNamespace()
+            result.record = lambda stream: self.log.append(("record", result, stream))
+            return result
+
+        self.patches = [
+            mock.patch.object(torch.cuda, "Stream", return_value=self.side),
+            mock.patch.object(torch.cuda, "Event", side_effect=event),
+            mock.patch.object(torch.cuda, "current_stream", return_value=self.main),
+            mock.patch.object(
+                torch.cuda, "stream", return_value=contextlib.nullcontext()
+            ),
+            mock.patch.object(
+                torch.cuda, "is_current_stream_capturing", return_value=False
+            ),
+            mock.patch.object(
+                torch.cuda,
+                "synchronize",
+                side_effect=lambda: self.log.append(("sync",)),
+            ),
+        ]
+        for patch in self.patches:
+            patch.start()
+            self.addCleanup(patch.stop)
+
+    def test_serial_has_no_cross_stream_events(self):
+        schedule = module.IndexerProjectionSchedule("serial", (0, 1))
+        schedule.begin(0, object())
+        self.log.append(("query",))
+        result = schedule.key(0, lambda x: (self.log.append(("key",)), None), object())
+        self.assertIsNone(result)
+        self.assertEqual(self.log, [("query",), ("key",)])
+
+    def test_events_fork_before_query_and_join_before_consumption(self):
+        schedule = module.IndexerProjectionSchedule("events", (0,))
+        key = mock.Mock(spec=torch.Tensor)
+        ready, done = schedule.events[0]
+        schedule.begin(0, object())
+        self.log.append(("query",))
+
+        def projection(x):
+            self.log.append(("key",))
+            return key, None
+
+        self.assertIs(schedule.key(0, projection, object()), key)
+        self.assertEqual(
+            self.log,
+            [
+                ("record", ready, self.main),
+                ("query",),
+                ("side_wait", ready),
+                ("key",),
+                ("record", done, self.side),
+                ("main_wait", done),
+            ],
+        )
+        key.record_stream.assert_called_once_with(self.main)
+
+    def test_every_tuple_input_is_retained_on_side(self):
+        schedule = module.IndexerProjectionSchedule("events", (0,))
+        values = [mock.Mock(spec=torch.Tensor) for _ in range(3)]
+        schedule.begin(0, tuple(values))
+        for value in values:
+            value.record_stream.assert_called_once_with(self.side)
+
+    def test_capture_does_not_record_allocator_streams(self):
+        schedule = module.IndexerProjectionSchedule("events", (0,))
+        value = mock.Mock(spec=torch.Tensor)
+        key = mock.Mock(spec=torch.Tensor)
+        with mock.patch.object(
+            torch.cuda, "is_current_stream_capturing", return_value=True
+        ):
+            schedule.begin(0, value)
+            schedule.key(0, lambda x: (key, None), value)
+        value.record_stream.assert_not_called()
+        key.record_stream.assert_not_called()
+
+    def test_failed_capture_preserves_previous_graph_events(self):
+        schedule = module.IndexerProjectionSchedule("events", (0,))
+        shape = mock.Mock(size=1, stream_idx=None, variant_label=None)
+        schedule.prepare_capture(shape)
+        first = schedule.events
+        schedule.finish_capture(shape)
+        schedule.prepare_capture(shape)
+        self.assertIsNot(schedule.events, first)
+        schedule.finish_capture()
+        self.assertIs(schedule.graph_events[shape][1], first)
+        self.assertIs(schedule.events, schedule.eager_events)
+        self.assertEqual(self.log, [("sync",), ("sync",)])
+
+    def test_recapture_retains_each_live_graph_generation(self):
+        schedule = module.IndexerProjectionSchedule("events", (0,))
+        a = mock.Mock(size=1, stream_idx=None, variant_label=None)
+        b = mock.Mock(size=1, stream_idx=None, variant_label=None)
+        schedule.prepare_capture(a)
+        schedule.finish_capture(a)
+        old = schedule.graph_events[a]
+        schedule.prepare_capture(b)
+        schedule.finish_capture(b)
+        self.assertIsNot(old[1], schedule.graph_events[b][1])
+        schedule.prepare_capture(a)
+        schedule.finish_capture(a)
+        self.assertGreater(schedule.graph_events[a][0], old[0])
+        schedule.close()
+        self.assertFalse(schedule.graph_events)
+        self.assertFalse(schedule.events)
+
+    def test_invalid_mode_scope_and_empty_layers_refuse(self):
+        for mode, layers in [("poll", (0,)), ("events", ()), ("events", (0, 0))]:
+            with self.assertRaises(ValueError):
+                module.IndexerProjectionSchedule(mode, layers)
+        schedule = module.IndexerProjectionSchedule("events", (0,))
+        for kwargs in [
+            dict(size=0),
+            dict(size=2),
+            dict(stream_idx=0),
+            dict(variant_label="lora"),
+        ]:
+            fields = dict(size=1, stream_idx=None, variant_label=None)
+            fields.update(kwargs)
+            with self.assertRaises(ValueError):
+                schedule.prepare_capture(SimpleNamespace(**fields))
+
+
+if __name__ == "__main__":
+    import unittest
+
+    unittest.main()
